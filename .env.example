APP_NAME=Hale
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=fa
APP_FALLBACK_LOCALE=fa
APP_FAKER_LOCALE=fa_IR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=hale
DB_USERNAME=hale
DB_PASSWORD=secret

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=s3
MEDIA_DISK=s3
AI_OUTPUT_DISK=s3
# Comma-separated provider keys in fallback order (empty = registration order)
AI_PROVIDER_PRIORITY=
# AI driver (local) and daily budget guardrail (USD)
AI_DRIVER=local
AI_DAILY_BUDGET_USD=50
# Output retention, size cap and processing lease (seconds)
AI_OUTPUT_RETENTION_DAYS=90
AI_MAX_OUTPUT_BYTES=52428800
AI_PROCESSING_LEASE_SECONDS=600
# Text generation parameters (caption)
AI_TEXT_TEMPERATURE=0.9
AI_TEXT_MAX_TOKENS=540
# Budget reservation estimates (USD); actual cost is settled after each run
AI_PRICING_IMAGE_USD=0.04
AI_PRICING_VIDEO_PER_SECOND_USD=0.05
# Google AI provider (image/video/text)
GOOGLE_AI_API_KEY=
GOOGLE_AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GOOGLE_IMAGEN_MODEL=imagen-3.0-generate-002
GOOGLE_VEO_MODEL=veo-2.0-generate-001
GOOGLE_AI_TIMEOUT=60
GOOGLE_VEO_TIMEOUT=120
# Optional per-provider pricing overrides (USD)
GOOGLE_IMAGEN_PRICING_IMAGE_USD=
GOOGLE_VEO_PRICING_PER_SECOND_USD=
# Text completion model for the caption generator
GOOGLE_TEXT_MODEL=gemini-2.0-flash
# Credit cost of one caption (non-image AI task)
CREDIT_COST_TEXT=3
# Welcome credits on signup and low-credit alert threshold (percent)
INITIAL_CREDIT_BALANCE=30
LOW_CREDIT_THRESHOLD=20
# Search driver: database (default, LIKE) or meilisearch (DB fallback on errors)
SEARCH_DRIVER=database
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_KEY=
MEILISEARCH_TIMEOUT=5
MEILISEARCH_PRODUCTS_INDEX=products
MEILISEARCH_GENERATIONS_INDEX=generations
# Web Push (VAPID) - generate a pair with: php artisan webpush:generate-keys
# Empty keys disable push sending entirely (the dashboard hides the button).
WEBPUSH_SUBJECT=mailto:hello@example.com
WEBPUSH_VAPID_PUBLIC_KEY=
WEBPUSH_VAPID_PRIVATE_KEY=
WEBPUSH_TTL=3600
# Seasonal studio theme: auto (date windows) | a theme key from
# config/seasons.php (yalda, black_friday, valentine, nowruz, winter,
# spring, summer, autumn_rain) | off
SEASON_THEME=auto
# Web image delivery: max dimension and quality of the WebP variant
MEDIA_WEB_MAX_DIMENSION=1600
MEDIA_WEB_QUALITY=82
# Output quality tiers: max dimension per tier (standard=1K, premium=2K)
MEDIA_STANDARD_MAX_DIMENSION=1024
MEDIA_PREMIUM_MAX_DIMENSION=2048
# USD conversion rates used to display provider costs in IRR/Toman
FINANCIAL_USD_TO_IRR=10000000
FINANCIAL_USD_TO_TOMAN=1000000
QUEUE_CONNECTION=redis
CACHE_STORE=redis
# CACHE_PREFIX=
MEMCACHED_HOST=127.0.0.1

SMS_DRIVER=fake
SMS_IR_API_KEY=
SMS_IR_BASE_URL=https://api.sms.ir
SMS_IR_TEMPLATE_ID=
SMS_IR_CODE_PARAMETER=Code
SMS_IR_TIMEOUT=10
PHONE_VERIFICATION_FREE_CREDITS=30
# Fixed OTP accepted by the fake driver (never set in production)
PHONE_VERIFICATION_TESTING_CODE=

PAYMENT_DRIVER=zarinpal
# WARNING: Change to a cryptographically secure random key in production (e.g. openssl rand -hex 32)
PAYMENT_WEBHOOK_SECRET=change-me
ZARINPAL_MERCHANT_ID=
# true = sandbox gateway for testing
ZARINPAL_SANDBOX=false
ZARINPAL_BASE_URL=https://payment.zarinpal.com
ZARINPAL_START_PAY_URL=https://payment.zarinpal.com/pg/StartPay
ZARINPAL_CALLBACK_URL=http://localhost:8080/api/payments/zarinpal/callback
ZARINPAL_CURRENCY=IRR
ZARINPAL_TIMEOUT=15

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=hale
AWS_SECRET_ACCESS_KEY=hale-secret
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=hale
AWS_ENDPOINT=http://minio:9000
AWS_URL=http://localhost:9000/hale
AWS_USE_PATH_STYLE_ENDPOINT=true

# Admin panel access: comma-separated email addresses
ADMIN_EMAILS=
# Stateful token cookie lifetime (minutes)
AUTH_COOKIE_MINUTES=43200

VITE_APP_NAME="${APP_NAME}"
