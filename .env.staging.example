# Hale AI Studio — Staging Environment Configuration Template

APP_NAME="Hale Staging"
APP_ENV=staging
APP_KEY=
APP_DEBUG=false
APP_URL=https://staging.hale.ai

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# Staging Database (Docker container: mysql)
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=hale_staging
DB_USERNAME=hale_staging
DB_PASSWORD=staging_secret_password

# Staging Cache & Queue (Docker container: redis)
BROADCAST_CONNECTION=log
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Staging MinIO / S3 Object Storage
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=hale_staging
AWS_SECRET_ACCESS_KEY=staging_minio_secret
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=hale
AWS_ENDPOINT=http://minio:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

# Zarinpal Gateway (Sandbox mode active on Staging)
ZARINPAL_MERCHANT_ID=00000000-0000-0000-0000-000000000000
ZARINPAL_SANDBOX=true
ZARINPAL_CALLBACK_URL=https://staging.hale.ai/api/payments/zarinpal/callback

# SMS.ir (Sandbox or Staging API credentials)
SMS_IR_API_KEY=your_staging_sms_ir_api_key
SMS_IR_LINE_NUMBER=3000xxxx
SMS_IR_VERIFY_TEMPLATE_ID=100000

# Error Tracking (Sentry Staging Environment)
SENTRY_LARAVEL_DSN=
SENTRY_ENVIRONMENT=staging

# AI providers (image, video with the product photo, edit, translation)
# Without a key the app stays on the local placeholder - a real PNG and a
# real MP4 structure - and `php artisan ai:verify` says plainly that
# nothing was verified, which is the honest answer until staging has one.
AI_DRIVER=local
GOOGLE_AI_API_KEY=
GOOGLE_AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GOOGLE_IMAGEN_MODEL=imagen-3.0-generate-002
GOOGLE_IMAGE_EDIT_MODEL=gemini-2.5-flash-image
GOOGLE_VEO_MODEL=veo-2.0-generate-001
GOOGLE_TEXT_MODEL=gemini-2.0-flash
GOOGLE_AI_TIMEOUT=60
GOOGLE_VEO_TIMEOUT=120
# A video render is a polled operation, not one request: how long Hale
# waits on one, and how long it sleeps between polls.
GOOGLE_VEO_OPERATION_TIMEOUT=300
GOOGLE_VEO_POLL_INTERVAL=5
